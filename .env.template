# =============================================================================
# Skill Seeker 环境变量配置文件
# =============================================================================
# 复制此文件为 .env 并填入你的实际配置
# 注意：.env 文件不会提交到 Git（已被 .gitignore 忽略）
# =============================================================================

# =============================================================================
# 1. MiniMax 配置（可选，用于 AI 增强）
# =============================================================================
# 用途：以 1/10 的成本使用类似 Claude 的 AI 增强功能
# 官网：https://platform.minimaxi.com/
# 是否必须：❌ 可选（如果不使用 AI 增强功能，可留空）

# MiniMax API 基础 URL（Anthropic 兼容格式）
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# MiniMax API Key（从 https://platform.minimaxi.com/ 获取）
# 推荐使用 Coding Plan 套餐（专为 AI 编程优化）
ANTHROPIC_AUTH_TOKEN=
# 使用的模型
ANTHROPIC_MODEL=MiniMax-M2.1


# =============================================================================
# 2. Anthropic Claude 配置（可选，用于上传到 Claude）
# =============================================================================
# 用途：将生成的 skill 上传到 Claude AI
# 官网：https://console.anthropic.com/
# 是否必须：❌ 可选（如果手动上传，可留空）

# Claude API Key（sk-ant-xxx 格式）
ANTHROPIC_API_KEY=your_claude_api_key_here


# =============================================================================
# 3. Google Gemini 配置（可选）
# =============================================================================
# 用途：生成 Gemini 格式的 skill
# 官网：https://aistudio.google.com/
# 是否必须：❌ 可选

GOOGLE_API_KEY=your_google_api_key_here


# =============================================================================
# 4. OpenAI 配置（可选）
# =============================================================================
# 用途：生成 ChatGPT 格式的 skill
# 官网：https://platform.openai.com/
# 是否必须：❌ 可选

OPENAI_API_KEY=your_openai_api_key_here


# =============================================================================
# 5. GitHub Token（可选，用于抓取私有仓库）
# =============================================================================
# 用途：访问私有 GitHub 仓库，避免速率限制
# 官网：https://github.com/settings/tokens
# Token 权限：需要 repo 权限
# 是否必须：❌ 可选（公开仓库不需要）

GITHUB_TOKEN=your_github_personal_access_token_here


# =============================================================================
# 6. PaddleOCR 配置（通常不需要配置）
# =============================================================================
# PaddleOCR 会自动下载模型，无需手动配置
# 如果网络问题，可设置代理：
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port


# =============================================================================
# 7. Tesseract OCR 配置（可选，用于备用 OCR 引擎）
# =============================================================================
# Tesseract 需要系统级安装
# Ubuntu/Debian: sudo apt-get install tesseract-ocr
# macOS: brew install tesseract
# Windows: 下载地址 https://github.com/tesseract-ocr/tesseract/wiki/Downloads
# 是否必须：❌ 可选（PaddleOCR 是默认推荐引擎）

# Tesseract 可执行文件路径（通常不需要设置）
# TESSERACT_CMD=/usr/bin/tesseract


# =============================================================================
# 8. 开发调试配置（可选）
# =============================================================================

# 启用详细日志（1=启用，0=禁用）
DEBUG=0

# 禁用模型源检查（PaddleOCR）
DISABLE_MODEL_SOURCE_CHECK=True


# =============================================================================
# 使用说明
# =============================================================================
#
# 1. 复制此文件为 .env：
#    cp .env.template .env
#
# 2. 编辑 .env，填入你的配置：
#    nano .env
#
# 3. 加载环境变量（当前终端有效）：
#    source .env
#
# 4. 永久生效（添加到 shell 配置）：
#    echo "source /path/to/.env" >> ~/.bashrc  # 或 ~/.zshrc
#
# =============================================================================
